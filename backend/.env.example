MONGO_URI=mongodb://localhost:27017/CommunicationIQ

MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
JWT_SECRET=your-jwt-secret-here
APP_URL=http://localhost:3010
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010"]

# Working storage. Everything (student audio, prompts, exports) lands under here
# until object storage is wired in behind the Storage contract.
MEDIA_ROOT=../tmp
RECORDING_RETENTION_DAYS=30

# Groq API for automatic question generation
GROQ_API_KEY=your-groq-api-key-here
AUTO_QUESTION_GENERATION=true


